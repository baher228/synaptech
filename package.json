{
  "name": "synaptech",
  "private": true,
  "scripts": {
    "backend:bootstrap": "python -m venv backend\\.venv && npm run backend:install",
    "backend:install": "backend\\.venv\\Scripts\\python -m pip install -r backend\\requirements.txt",
    "backend:dev": "backend\\.venv\\Scripts\\python -m uvicorn app.main:app --reload --port 8001 --app-dir backend",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build"
  }
}
